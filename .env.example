# Database Configuration
# For local development, use: mongodb://localhost:27017/drop-master
# For MongoDB Atlas, use your cluster connection string
MONGO_URL=mongodb://localhost:27017/drop-master

# JWT Configuration
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_use_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# OpenAI API for AI-powered translation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Session Configuration
# Generate a secure secret for sessions
SESSION_SECRET=your_session_secret_here

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Kakao OAuth Configuration
# Get credentials from: https://developers.kakao.com/
KAKAO_CLIENT_ID=your_kakao_client_id_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here
KAKAO_CALLBACK_URL=http://localhost:3001/api/auth/kakao/callback

# Naver OAuth Configuration
# Get credentials from: https://developers.naver.com/
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
NAVER_CALLBACK_URL=http://localhost:3001/api/auth/naver/callback

# External Shopping Platform API Keys
# Naver Shopping API: https://developers.naver.com/
NAVER_SHOPPING_API_KEY=your_naver_shopping_api_key_here
NAVER_SHOPPING_API_SECRET=your_naver_shopping_api_secret_here

# Coupang API (when available)
COUPANG_API_KEY=your_coupang_api_key_here

# 11st API (when available)
ELEVENST_API_KEY=your_11st_api_key_here
